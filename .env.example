# Copy to .env and adjust. All variables are optional except CPTEA_SECRET_KEY in production.

# Signing key for login tokens. Use a long random string, e.g.: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
CPTEA_SECRET_KEY=replace-with-a-long-random-string

# First administrator, created on first start only. Must change the password at first sign-in.
CPTEA_ADMIN_USERNAME=admin
CPTEA_ADMIN_PASSWORD=ChangeMe!2026

# Where the database, uploads and run results live (a Docker volume by default)
CPTEA_DATA_DIR=/data
# Optional: PostgreSQL instead of SQLite, e.g. postgresql+psycopg://cptea:secret@db:5432/cptea
# CPTEA_DB_URL=

# Sessions
CPTEA_SESSION_IDLE_MINUTES=30
CPTEA_MAX_FAILED_LOGINS=5
CPTEA_LOCKOUT_MINUTES=15

# AirNav flight data API (reachable only on the AirNav VPN) and optional bearer token
CPTEA_FLIGHT_API_URL=http://172.20.17.117:3000
CPTEA_FLIGHT_API_TOKEN=

# NavEarth WFS endpoint for aeronautical data
# CPTEA_NAVEARTH_WFS=

# Map tiles. Leave the default for OpenStreetMap, point it at an internal tile server, or set empty to use only the built-in coastline.
CPTEA_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
